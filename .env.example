VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-publishable-or-anon-key

# Server-only Edge Function secrets (never VITE_ variables, never committed):
#   GTOPUP_API_KEY — top-up provider key used by the bren-topup function.
#   APP_ORIGIN — trusted storefront origin used by bren-invite and bren-topup.
# Set them with `npx supabase secrets set ...`; for local functions use the
# ignored supabase/functions/.env.local file instead.
