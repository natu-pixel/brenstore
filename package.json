{
  "name": "brenstore",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "node scripts/local-dev.ts",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:edge": "tsc -p tsconfig.edge.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "test:stress": "vitest run --config vitest.postgres.config.ts tests/postgres/stress.test.ts",
    "db:test": "supabase test db",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.3.0",
    "@supabase/supabase-js": "^2.117.0",
    "@tabler/icons-react": "^3.47.0",
    "@tanstack/react-query": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.0.0",
    "simple-icons": "^16.32.0",
    "three": "^0.186.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/deno": "^2.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "embedded-postgres": "17.10.0-beta.17",
    "jsdom": "^27.0.0",
    "oxlint": "^1.81.0",
    "pg": "^8.0.0",
    "supabase": "^2.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.0.0"
  }
}
